model User {
    id           Int       @id @default(autoincrement())
    uuid         String    @unique @default(uuid())
    phoneNumber String    @unique
    email        String?
    password     String?
    firstName   String?
    lastName    String?
    age          Int?
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt
    deletedAt    DateTime?
}
